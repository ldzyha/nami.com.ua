rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }
    match /orders/{orderId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
